Screen {
    background: $surface;
}

#chat {
    background: $panel;
    border: round $primary;
    padding: 0 1;
    margin: 1;
}

#input {
    dock: bottom;
    margin: 0 1 1 1;
    border: round $accent;
}

#status {
    dock: bottom;
    height: 1;
    background: $boost;
    color: $text-muted;
    padding: 0 1;
}

#perm-dialog {
    background: $surface;
    border: thick $warning;
    padding: 1 2;
    width: 70;
    height: auto;
    align: center middle;
}

#perm-title {
    text-style: bold;
    color: $warning;
    padding-bottom: 1;
}

#perm-cmd {
    color: $text;
    padding-bottom: 1;
}

#perm-reason {
    color: $text-muted;
    padding-bottom: 1;
}


/* ---------- Picker modal ---------- */
#picker-dialog {
    background: $surface;
    border: thick $accent;
    padding: 1 2;
    width: 80%;
    max-width: 100;
    max-height: 80%;
    align: center middle;
}

#picker-title {
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
}

#picker-subtitle {
    color: $text-muted;
    padding-bottom: 1;
}

#picker-search {
    margin-bottom: 1;
}

#picker-scroll {
    height: 1fr;
    min-height: 8;
    max-height: 20;
    border: round $primary;
    padding: 0 1;
    background: $panel;
}

#picker-list {
    height: auto;
}

.picker-item {
    color: $text;
}

.picker-selected {
    color: $accent;
    text-style: bold;
    background: $boost;
}

.picker-empty {
    color: $text-muted;
    text-style: italic;
}
